{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node .claude/scripts/check-setup.mjs *)",
      "PowerShell(node .claude/scripts/check-setup.mjs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Edit(desktop-agent/src/**)",
      "Edit(desktop-agent/tests/**)",
      "Edit(desktop-agent/examples/**)",
      "Edit(desktop-agent/Cargo.toml)",
      "Edit(android-controller/lib/**)",
      "Edit(android-controller/test/**)",
      "Edit(android-controller/android/**)",
      "Edit(android-controller/pubspec.yaml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/check-setup.mjs\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
