{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter --version)",
      "Bash(flutter doctor *)",
      "Bash(flutter pub get)",
      "Bash(flutter pub add *)",
      "Bash(flutter pub outdated *)",
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(dart format *)",
      "Bash(dart run build_runner *)",
      "Bash(adb devices *)",
      "PowerShell(flutter --version)",
      "PowerShell(flutter doctor *)",
      "PowerShell(flutter pub get)",
      "PowerShell(flutter pub add *)",
      "PowerShell(flutter pub outdated *)",
      "PowerShell(flutter analyze *)",
      "PowerShell(flutter test *)",
      "PowerShell(dart format *)",
      "PowerShell(dart run build_runner *)",
      "PowerShell(adb devices *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Edit(../CLAUDE.md)",
      "Edit(../contract/**)",
      "Edit(../desktop-agent/**)"
    ],
    "additionalDirectories": ["../contract"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
